<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.KharkivMetro" parent="@style/Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Same token as the bottom bar so the gesture area reads as
             one block instead of a dead band. -->
        <item name="android:windowBackground">?attr/colorSurfaceContainer</item>
    </style>

    <style name="MyPopupStyle" parent="android:TextAppearance.Holo.Widget.PopupMenu.Large">
        <item name="android:textColor">#212121</item>
        <item name="android:textSize">16dp</item>
    </style>
</resources>